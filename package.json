{
  "name": "mohyeon-jeil-153",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "node scripts/run-vite.mjs",
    "build": "vite build",
    "build:netlify": "node scripts/migrate-netlify.mjs && vite build",
    "start": "node dist/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:browser": "node scripts/start-browser-regression.mjs",
    "validate:artifact": "test -f dist/server/index.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .output",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "db:migrate:validate": "node scripts/validate-netlify-migrations.mjs",
    "db:backfill:songs": "node scripts/backfill-archive-songs.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "heic2any": "^0.0.4",
    "next": "16.3.3",
    "nitro": "^3.0.260610-beta",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.128.0"
  },
  "type": "module",
  "displayName": "모현제일교회 153 디자인"
}
